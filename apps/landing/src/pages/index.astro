---
import { CourseMarketing } from "../components/home/course-marketing";
import { CTA } from "../components/home/cta";
import { FAQ, faqs } from "../components/home/faq";
import { Hero } from "../components/home/hero";
import { HowItWorks } from "../components/home/how-it-works";
import { OpenSource } from "../components/home/open-source";
import LandingLayout from "../layouts/LandingLayout.astro";

const description =
  "Gately is a free, open-source visual logic circuit editor. Build circuits on a drag-and-drop canvas and explore digital logic through live simulation.";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Gately",
    url: "https://gately.dev",
    logo: "https://gately.dev/favicon.svg",
    sameAs: ["https://github.com/jakmaz/gately"],
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Gately",
    url: "https://app.gately.dev",
    applicationCategory: "EducationalApplication",
    operatingSystem: "Web, Windows, macOS, Linux",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<LandingLayout home description={description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")} />
  <Hero client:load />
  <HowItWorks client:load />
  <CourseMarketing client:load />
  <OpenSource />
  <div class="wrap">
    <FAQ />
    <CTA />
  </div>
</LandingLayout>
