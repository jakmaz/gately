---
import type { MarkdownHeading } from "astro";
import { docsSections } from "../components/docs/docs-config";
import LessonNavigation from "../components/docs/lesson-navigation.astro";
import LandingLayout from "./LandingLayout.astro";
import "../styles/learn.css";

interface Props {
  frontmatter: { title: string; description?: string };
  headings?: MarkdownHeading[];
}

const { frontmatter, headings = [] } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\.html$/, "").replace(/\/+$/, "");
const pageUrl = new URL(currentPath, Astro.site).href;
const topics = docsSections.flatMap((section) => section.topics);
const currentIndex = topics.findIndex((topic) => topic.href === currentPath);
const previous = currentIndex > 0 ? topics[currentIndex - 1] : null;
const next = currentIndex >= 0 ? topics[currentIndex + 1] : null;
const section = docsSections.find((section) => section.topics.some((topic) => topic.href === currentPath));
const contents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: frontmatter.title,
    description: frontmatter.description ?? "",
    url: pageUrl,
    author: { "@type": "Organization", name: "Gately", url: "https://gately.dev" },
    isPartOf: { "@type": "LearningResource", name: "Learn digital logic with Gately" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://gately.dev/" },
      { "@type": "ListItem", position: 2, name: "Learn", item: "https://gately.dev/learn/first-circuit" },
      { "@type": "ListItem", position: 3, name: frontmatter.title, item: pageUrl },
    ],
  },
];
---

<LandingLayout learn title={frontmatter.title} description={frontmatter.description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")} />
  <div class="wrap learn-shell">
    <aside class="learn-sidebar">
      <a class="learn-home" href="/learn/first-circuit">Learn</a>
      <p class="learn-sidebar-description">Digital logic with Gately.</p>
      <LessonNavigation currentPath={currentPath} />
    </aside>
    <div class="learn-content">
      <details class="learn-mobile-menu">
        <summary>
          Browse lessons
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </summary>
        <LessonNavigation currentPath={currentPath} />
      </details>
      <article class="learn-article">
        <header class="learn-article-header">
          <nav class="learn-breadcrumb" aria-label="Breadcrumb">
            <a href="/learn/first-circuit">Learn</a>
            <span aria-hidden="true">/</span>
            <span>{section?.title ?? "Digital logic"}</span>
          </nav>
          <h1>{frontmatter.title}</h1>
          {frontmatter.description && <p>{frontmatter.description}</p>}
        </header>
        <div class="markdown-body"><slot /></div>
      </article>
      {(previous || next) && (
        <nav class="learn-pagination" aria-label="Lesson navigation">
          {previous && (
            <a href={previous.href} rel="prev">
              <span>Previous lesson</span>
              <strong><span aria-hidden="true">←</span> {previous.label}</strong>
            </a>
          )}
          {next && (
            <a class="learn-next" href={next.href} rel="next">
              <span>Next lesson</span>
              <strong>{next.label} <span aria-hidden="true">→</span></strong>
            </a>
          )}
        </nav>
      )}
    </div>
    {contents.length > 0 && (
      <aside class="learn-toc">
        <nav aria-labelledby="learn-toc-title">
          <h2 id="learn-toc-title">On this page</h2>
          <ul>
            {contents.map((heading) => (
              <li class:list={[{ "learn-toc-nested": heading.depth === 3 }]}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</LandingLayout>
